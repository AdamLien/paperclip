{
  "manifest_version": 3,
  "name": "metabiz Crew Chrome Companion",
  "version": "0.2.0",
  "description": "Share one selected Chrome tab with your mCrew browser session. Stop sharing at any time.",
  "permissions": [
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "https://crew.metabiz.work/*",
    "https://crew-uat.metabiz.work/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "mCrew \u700f\u89bd\u5668",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crew.metabiz.work/*",
        "https://crew-uat.metabiz.work/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
